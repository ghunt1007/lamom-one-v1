rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // สิทธิ์แบบจำกัดเวลา (accessExpiresAt) — ถ้า field นี้มีค่าและผ่านมาแล้ว ถือว่าหมดสิทธิ์ทันที
    // ไม่ว่า field "role" จะยังเป็นอะไรอยู่ก็ตาม (บังคับที่ระดับ rules จริง ไม่ใช่แค่ซ่อนปุ่มที่ UI
    // ซึ่งหลบเลี่ยงได้ด้วยการยิง request ตรง) ไม่มี field นี้ (null) = สิทธิ์ไม่มีวันหมดอายุตามปกติ
    function userRole() {
      return isSignedIn()
        ? roleFromProfile(get(/databases/$(database)/documents/users/$(uid())).data)
        : 'anonymous';
    }

    function roleFromProfile(profile) {
      return (profile.get('accessExpiresAt', null) != null && profile.get('accessExpiresAt', null) < request.time)
        ? 'expired'
        : profile.get('role', 'viewer');
    }

    function isOwner() {
      return isSignedIn() && userRole() == 'owner';
    }

    function isAdmin() {
      return isSignedIn() && userRole() in ['owner', 'admin'];
    }

    function isManager() {
      return isSignedIn() && userRole() in ['owner', 'admin', 'manager'];
    }

    function isStaff() {
      return isSignedIn() && userRole() in ['owner', 'admin', 'manager', 'sales', 'service', 'finance', 'hr', 'staff'];
    }

    function isFinance() {
      return isSignedIn() && userRole() in ['owner', 'admin', 'manager', 'finance'];
    }

    function isHR() {
      return isSignedIn() && userRole() in ['owner', 'admin', 'manager', 'hr'];
    }

    function isService() {
      return isSignedIn() && userRole() in ['owner', 'admin', 'manager', 'service'];
    }

    function isSales() {
      return isSignedIn() && userRole() in ['owner', 'admin', 'manager', 'sales'];
    }

    // ระบบยังไม่มีผู้ใช้คนแรก (ยังไม่มี meta/init) — ใช้ตอน bootstrap owner คนแรกเท่านั้น
    function isBootstrapping() {
      return !exists(/databases/$(database)/documents/meta/init);
    }

    // ── Role hierarchy (v1.0.305) ────────────────────────────────────────────
    // เดิม rules ตรวจแค่ "isManager() หรือไม่" ตอนสร้าง/แก้ user คนอื่น ไม่เคยตรวจว่า role ที่จะตั้งให้
    // "ต่ำกว่า" ตัวเองจริงหรือไม่ (ทั้งที่หน้า UserManagement.js ฝั่ง client บังคับไว้ชัดเจนอยู่แล้วผ่าน
    // canCreate()/myLevel>targetLevel) แปลว่า manager ธรรมดายิง request ตรงผ่าน Firestore SDK ตั้ง
    // role ตัวเอง/คนอื่นเป็น 'owner' ได้ทันที (privilege escalation เต็มรูปแบบ) ระดับตรงกับ ROLES ใน
    // UserManagement.js ทุกตัว
    function roleLevel(role) {
      return role == 'owner' ? 100
        : role == 'admin' ? 90
        : role == 'manager' ? 70
        : role == 'finance' ? 60
        : role == 'hr' ? 60
        : role == 'sales' ? 40
        : role == 'service' ? 40
        : role == 'staff' ? 20
        : 0;
    }

    function myRoleLevel() {
      return roleLevel(userRole());
    }

    // ต้อง "สูงกว่า" ระดับที่จะกำหนดให้อย่างเคร่งครัด (ตรงกับ canCreate() ฝั่ง client เป๊ะ) — ห้องกัน
    // manager/admin ตั้ง role ให้เท่ากับหรือสูงกว่าตัวเอง (เช่น manager ตั้งให้ตัวเองเป็น owner)
    function canAssignRole(role) {
      return myRoleLevel() > roleLevel(role);
    }

    // ── Numeric bounds helpers ───────────────────────────────────────────────
    // เดิม rules ตรวจแค่ "ใครมีสิทธิ์เขียน" ไม่เคยตรวจ "ค่าที่เขียนสมเหตุสมผลหรือไม่" เลยแม้แต่ field
    // เดียวในทั้งไฟล์ — ต่อให้ UI มี min="0" ก็ข้ามได้ง่ายๆด้วยการยิง request ตรงผ่าน Firestore SDK เพราะ
    // ไม่มีอะไรบังคับที่ฝั่ง server เลย เพิ่มเช็คเฉพาะ field เงิน/จำนวนที่ (1) กระทบธุรกิจจริงและ (2) ไม่มี
    // เหตุผลทางธุรกิจที่ควรเป็นค่าติดลบ — ไม่แตะ field ที่ติดลบได้จริงตามธรรมชาติ (margin ขาดทุน, ส่วนลด
    // พิเศษที่รอผู้จัดการอนุมัติ, ใบลดหนี้, ยอดหักเงินเดือนที่แก้คืนย้อนหลัง) เพื่อไม่ให้ไปบล็อกงานจริง
    function nonNegIfPresent(field) {
      return !(field in request.resource.data)
        || !(request.resource.data[field] is number)
        || request.resource.data[field] >= 0;
    }

    function positiveIfPresent(field) {
      return !(field in request.resource.data)
        || !(request.resource.data[field] is number)
        || request.resource.data[field] > 0;
    }

    // อัตราคอมมิชชั่นแบบ % (type=='percent') ต้องอยู่ในช่วง 0-100 เท่านั้น — UI หน้า CommissionRules
    // บังคับ min="0" max="100" อยู่แล้วสำหรับ type นี้โดยเฉพาะ (type อื่นเช่น per_unit/bonus เป็นจำนวนเงิน
    // บาทไม่ใช่ % จึงไม่จำกัดเพดานนี้) แต่ rules ไม่เคยบังคับจริงมาก่อน
    function validCommissionValue() {
      return nonNegIfPresent('value')
        && (request.resource.data.get('type', '') != 'percent'
            || !('value' in request.resource.data)
            || request.resource.data.value <= 100);
    }

    // ── Meta / System Init ────────────────────────────────────────────────────
    // Any signed-in user can read (to detect first-user scenario)
    // Any signed-in user can create init doc (first-time bootstrap)
    // Only admin can update/delete
    match /meta/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // AI personal data — subcollections (private per user)
    match /users/{userId}/ai_memories/{docId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }
    match /users/{userId}/ai_conversations/{docId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    match /users/{userId} {
      // แก้ไข (2026-07-23): เดิมใช้ isAdmin() (owner/admin เท่านั้น) แต่หน้า User Management ของแอป
      // เขียนไว้ชัดเจนว่า "ผู้จัดการขึ้นไป" (manager level 70 ≥ MIN_CREATE_LEVEL 60) จัดการผู้ใช้ได้ —
      // แปลว่า manager กด UserManagement มาก่อนหน้านี้จะเจอ permission-denied ตอนอ่านรายชื่อผู้ใช้เลย
      // (bug ที่ค้างมาก่อน ไม่เกี่ยวกับงานตอนนี้ แต่ไปกระทบฟีเจอร์ต่ออายุสิทธิ์ที่เพิ่มใหม่โดยตรง) แก้ให้ตรง
      // กับที่ UI ตั้งใจไว้จริง — ยังไม่ได้เพิ่มการตรวจ "ต้องสร้าง/แก้ role ต่ำกว่าตัวเองเท่านั้น" ที่ระดับ
      // rules (ตอนนี้ตรวจแค่ที่ UI ฝั่ง client เท่านั้น เหมือนที่ isAdmin() เดิมก็ไม่ตรวจระดับกันอยู่แล้ว)
      allow read: if isSignedIn() && (uid() == userId || isManager());
      // Self-create only allowed as the very first owner (bootstrap, no meta/init yet)
      // or as a 'pending' account awaiting admin approval — never with a privileged role.
      // ป้องกัน privilege escalation: ผู้ใช้ทั่วไปสร้าง/แก้ profile ตัวเองให้เป็น owner/admin เองไม่ได้
      // (v1.0.305) เพิ่ม canAssignRole() บังคับที่ระดับ rules จริง — เดิม isManager() เฉยๆยอมให้ manager
      // ตั้ง role ใหม่เป็น owner/admin ได้เอง (ดูคอมเมนต์ที่ roleLevel() ด้านบน)
      allow create: if (isManager() && canAssignRole(request.resource.data.role))
        || (isSignedIn() && uid() == userId && isBootstrapping() && request.resource.data.role == 'owner')
        || (isSignedIn() && uid() == userId && !isBootstrapping() && request.resource.data.role == 'pending');
      // ผู้ใช้แก้ไข field ตัวเองได้ (เช่น displayName) แต่ห้ามแก้ role/permissions/active/accessExpiresAt เอง
      // เด็ดขาด ต้องให้ manager ขึ้นไปเป็นคนเปลี่ยนสิทธิ์เท่านั้น
      // (v1.0.305) ต้อง canAssignRole ทั้ง role เดิมและ role ใหม่ — กันไม่ให้ manager แก้ไข/ตั้ง role
      // ของคนที่ "เท่ากับหรือสูงกว่า" ตัวเอง (รวมถึงตัวเอง ผ่านสาขา isManager() นี้เอง) เป็น owner/admin
      allow update: if (isManager() && canAssignRole(request.resource.data.get('role', 'staff')) && canAssignRole(resource.data.get('role', 'staff')))
        || (isSignedIn() && uid() == userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'active', 'accessExpiresAt']));
      allow delete: if isOwner();
    }

    // ── Roles & Permissions — owner only ─────────────────────────────────────
    match /roles/{docId} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    // ── Audit Logs — immutable once written ──────────────────────────────────
    // ชื่อ collection จริงคือ audit_log (ไม่ใช่ auditLogs) — เดิม rule นี้ไม่มีผลจริงเลย
    // เพราะชื่อไม่ตรงกับที่ src/core/db.js เขียนจริง เลยตกไปใช้ default rule ท้ายไฟล์
    // ซึ่งอนุญาตให้ staff แก้ไข/ลบได้ — ทำลายหลักฐาน audit ได้ ตอนนี้แก้ให้ตรงชื่อจริงแล้ว
    match /audit_log/{docId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ── Branches & Settings — admin manages ──────────────────────────────────
    match /settings/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /branches/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ── CRM & Sales ──────────────────────────────────────────────────────────
    match /customers/{docId} {
      allow read, write: if isStaff();
    }

    match /leads/{docId} {
      allow read, write: if isStaff();
    }

    match /bookings/{docId} {
      allow read: if isStaff();
      // ป้องกันราคา/เงินจอง/ยอดไฟแนนซ์/ยอดคืนเงินติดลบ — ไม่มีเหตุผลทางธุรกิจให้ค่าพวกนี้ติดลบได้จริง
      // (ไม่แตะ discount/margin/totalIncome เพราะขาดทุนได้จริงตามธรรมชาติของดีล)
      // (v1.0.304) เลขบัตรประชาชนลูกค้าย้ายไปเก็บที่ booking_national_ids แยกต่างหากแล้ว — bookings ทั้งหมด
      // ต้องเปิดให้ isStaff() อ่านได้กว้างต่อไป (ทุกแผนกต้องดูใบจองได้) แต่ nid ไม่มีเหตุผลให้ทุกแผนกเห็น
      // (เฉพาะฝ่ายขาย/การเงิน/ผู้จัดการที่ทำเอกสารไฟแนนซ์จริงเท่านั้นที่ต้องใช้) ห้ามเขียน/แก้ nid ผ่าน doc นี้
      // อีกต่อไป แต่เอกสารเก่าที่ยังฝัง nid อยู่ยังแก้ field อื่นได้ปกติ (เช็คเทียบค่าเดิมเหมือน staff.salary)
      allow create: if isStaff()
        && nonNegIfPresent('price') && nonNegIfPresent('cost') && nonNegIfPresent('down')
        && nonNegIfPresent('financeAmount') && nonNegIfPresent('refundAmount')
        && !('nid' in request.resource.data);
      allow update: if isStaff()
        && nonNegIfPresent('price') && nonNegIfPresent('cost') && nonNegIfPresent('down')
        && nonNegIfPresent('financeAmount') && nonNegIfPresent('refundAmount')
        && (!('nid' in request.resource.data) || request.resource.data.nid == resource.data.get('nid', null));
      allow delete: if isStaff();
    }

    // เก็บเลขบัตรประชาชนลูกค้าแยกจาก bookings doc (v1.0.304) — เดิม nid ฝังอยู่ใน bookings/{docId} ที่เปิด
    // ให้ isStaff() (พนักงานทุกแผนก รวมช่าง/บริการ/HR ที่ไม่เกี่ยวกับงานไฟแนนซ์เลย) อ่านได้กว้างมาก แปลว่า
    // ใครก็ดึงเลขบัตรประชาชนจริงของลูกค้าทุกคนผ่าน Firestore SDK ตรงๆได้ — ย้ายมาเก็บที่นี่แทน จำกัดเฉพาะ
    // ฝ่ายขาย/การเงิน/ผู้จัดการ (คนที่ทำเอกสารไฟแนนซ์จริงของดีลนั้น) id ของเอกสารตรงกับ id ของ bookings/{docId}
    // ตัวเดียวกันเสมอ (ความสัมพันธ์ 1:1)
    match /booking_national_ids/{docId} {
      allow read, write: if isSales() || isFinance() || isManager();
    }

    match /sales/{docId} {
      allow read, write: if isStaff();
    }

    match /comm_logs/{docId} {
      allow read, write: if isStaff();
    }

    // บันทึกว่าส่งคำอวยพรวันเกิด/ครบรอบให้ลูกค้ารายไหนไปแล้ว (กันส่งซ้ำ+รีเฟรชแล้วข้อมูลไม่หาย)
    match /greeting_sends/{docId} {
      allow read, write: if isStaff();
    }

    // (v1.0.307) เดิม isStaff() เขียนได้หมด — พนักงานคนไหนก็กดปุ่ม "✓ ยื่นแล้ว" ปลอมบันทึกว่ายื่นภาษี
    // ทันเวลาได้เอง ทั้งที่เป็นการยื่นแบบภาษีกับสรรพากรจริง (ปกปิดการยื่นล่าช้า/ไม่ยื่นได้) เป็นงานฝ่าย
    // การเงินโดยตรง (หน้านี้อยู่ใน src/pages/finance/ เท่านั้น ไม่มีหน้าอื่นอ่าน/เขียน collection นี้เลย)
    match /tax_filings/{docId} {
      allow read: if isStaff();
      allow create, update, delete: if isFinance() || isManager();
    }

    match /feedback_responses/{docId} {
      allow read, write: if isStaff();
    }

    match /customer_feedback/{docId} {
      allow read, write: if isStaff();
    }

    // แชทกลุ่ม (general/sales/service/management/announcements) เปิดให้ staff ทุกคนอ่าน/เขียนเหมือนเดิม
    // ยกเว้นข้อความ DM ส่วนตัว (channel ขึ้นต้นด้วย "dm_") ที่ต้องเป็นคู่สนทนา (participants) เท่านั้นถึงอ่าน/เขียนได้
    match /comm_messages/{docId} {
      allow read: if isStaff() && (!resource.data.get('channel', '').matches('^dm_.*') || uid() in resource.data.get('participants', []));
      allow create: if isStaff() && (!request.resource.data.get('channel', '').matches('^dm_.*') || uid() in request.resource.data.get('participants', []));
      allow update: if isStaff() && (!resource.data.get('channel', '').matches('^dm_.*') || uid() in resource.data.get('participants', []));
    }

    match /tasks/{docId} {
      allow read, write: if isStaff();
    }

    match /quotations/{docId} {
      allow read, write: if isStaff();
    }

    match /follow_ups/{docId} {
      allow read, write: if isStaff();
    }

    match /test_drives/{docId} {
      allow read, write: if isStaff();
    }

    match /appointments/{docId} {
      allow read, write: if isStaff();
    }

    // ── Stock & Vehicles ─────────────────────────────────────────────────────
    match /vehicles/{docId} {
      allow read: if isStaff();
      // ป้องกันราคา/ต้นทุนรถติดลบ — ไม่มีเหตุผลทางธุรกิจให้ราคาขาย/ต้นทุนต่อคันติดลบได้
      allow write: if isStaff() && nonNegIfPresent('price') && nonNegIfPresent('cost');
    }

    // ตรวจสอบเพิ่มเติม (v1.0.301) — พบว่า vehicle_catalog_overrides/_additions (ใช้เก็บการแก้ไข/เพิ่มรุ่นรถ
    // ในหน้า Vehicle Database รวมถึงตอนนำเข้าไฟล์ .json สำรอง/กู้คืนข้อมูล — importUserData() ใน
    // src/data/vehicleDatabase.js เขียนทุก field จากไฟล์ตรงๆไม่มีการกรอง) ไม่เคยมี match block มาก่อนเลย
    // ตกอยู่ใต้ catch-all isStaff() กว้างๆ ทำให้ค่าที่แก้/เพิ่มผ่านช่องทางนี้ (ซึ่งไปทับข้อมูลรถจริงที่แสดงผล
    // ทั่วทั้งแอปผ่าน applyOverridesTo()) ไม่ผ่านการเช็คราคา/ต้นทุนติดลบแบบเดียวกับ vehicles เลย — เพิ่มเช็ค
    // ตัวเลขแบบเดียวกัน ไม่จำกัดสิทธิ์ผู้ใช้เพิ่มเติม (ฟีเจอร์นี้ตั้งใจให้พนักงานทั่วไปแก้ไขข้อมูลรุ่นรถได้เหมือนเดิม)
    match /vehicle_catalog_overrides/{docId} {
      allow read: if isStaff();
      allow write: if isStaff() && nonNegIfPresent('price') && nonNegIfPresent('cost');
    }

    match /vehicle_catalog_additions/{docId} {
      allow read: if isStaff();
      allow write: if isStaff() && nonNegIfPresent('price') && nonNegIfPresent('cost');
    }

    match /vehicle_orders/{docId} {
      allow read, write: if isStaff();
    }

    match /parts/{docId} {
      allow read, write: if isStaff();
    }

    match /pdi/{docId} {
      allow read, write: if isStaff();
    }

    match /job_cards/{docId} {
      allow read, write: if isStaff();
    }

    match /service_appointments/{docId} {
      allow read, write: if isStaff();
    }

    // ── Finance — finance role & above ────────────────────────────────────────
    match /commissions/{docId} {
      allow read: if isFinance() || isManager();
      allow write: if isFinance();
    }

    match /payroll/{docId} {
      allow read: if isFinance() || isManager();
      allow write: if isFinance();
    }

    match /petty_cash/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isFinance() || isManager();
    }

    match /withholding_tax_certs/{docId} {
      allow read, write: if isFinance();
    }

    match /billing_runs/{docId} {
      allow read, write: if isFinance();
    }

    match /custom_order_docs/{docId} {
      allow read, write: if isFinance();
    }

    // เอกสารรวม (สัญญาซื้อขาย/ใบจอง/ใบส่งมอบ ฯลฯ) ปนกับสัญญาจ้าง HR และหนังสือมอบอำนาจในพูลเดียวกัน
    // เดิมพนักงานขายทั่วไปเปิด/แก้ไขสัญญาจ้าง HR ของคนอื่นได้เหมือนเอกสารขายทั่วไป — จำกัดแค่ 2 ประเภทนี้
    // ให้ HR/ผู้จัดการเท่านั้น ประเภทอื่น (booking/quote/contract ลูกค้า ฯลฯ) ยังเปิดกว้างเหมือนเดิม
    match /documents/{docId} {
      allow read, update, delete: if isStaff() &&
        (!(resource.data.get('type', '') in ['hr_contract', 'power_atty']) || isHR() || isManager());
      allow create: if isStaff() &&
        (!(request.resource.data.get('type', '') in ['hr_contract', 'power_atty']) || isHR() || isManager());
    }

    match /expenses/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isFinance() || isManager();
    }

    match /expense_approvals/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isManager();
    }

    match /cash_flow/{docId} {
      allow read: if isFinance() || isManager();
      allow write: if isFinance();
    }

    match /bank_reconciliation/{docId} {
      allow read, write: if isFinance();
    }

    match /bank_transactions/{docId} {
      allow read, write: if isFinance();
    }

    match /payroll_records/{docId} {
      allow read: if isFinance() || isManager();
      // ป้องกันเงินเดือนฐาน/OT/เบี้ยเลี้ยง/ประกันสังคมติดลบ — กระทบยอดจ่ายจริงที่พนักงานเห็นในสลิป
      // (ไม่แตะ deduction เพราะการแก้ยอดหักคืนย้อนหลังที่หักเกินไปเดือนก่อนต้องใช้ค่าติดลบได้จริง)
      allow write: if isFinance()
        && nonNegIfPresent('base') && nonNegIfPresent('ot') && nonNegIfPresent('allowance') && nonNegIfPresent('ssf');
    }

    match /salary_scale_staff/{docId} {
      allow read: if isFinance() || isManager();
      allow write: if isFinance();
    }

    match /bonus_pool_staff/{docId} {
      allow read: if isFinance() || isManager();
      allow write: if isFinance();
    }

    // ช่างอ่านได้ (เช็คสถานะโบนัสตัวเอง) แต่การ "อนุมัติ" (create) ต้องผู้จัดการ/การเงินเท่านั้น เพราะสั่งจ่ายเงินจริง
    match /tech_kpi_bonus_approvals/{docId} {
      allow read: if isStaff();
      allow write: if isFinance() || isManager();
    }

    match /financial_closings/{docId} {
      allow read, write: if isFinance();
    }

    match /debt_settlements/{docId} {
      allow read, write: if isFinance();
    }

    // ขอส่วนลดพิเศษ — เดิมพนักงานคนไหนก็กด "อนุมัติ/ปฏิเสธ" ส่วนลดของตัวเองได้เลยผ่านหน้าจอ (ตกอยู่ใต้
    // catch-all isStaff() กว้างเกินไป) ทั้งที่ควรเป็นสิทธิ์ผู้จัดการเท่านั้น — เปิดให้ staff ยื่นขอได้ (create)
    // แต่อนุมัติ/ปฏิเสธ (update) ต้องผู้จัดการขึ้นไปเท่านั้น
    match /price_negotiations/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isManager();
      allow delete: if isManager();
    }

    // ใบแจ้งหนี้/ใบเสร็จรับเงิน — เดิมพนักงานคนไหนก็กด "บันทึกรับชำระ" (ปิดยอดค้างรับ) ได้เลย ตกอยู่ใต้
    // catch-all isStaff() กว้างเกินไป ทั้งที่การรับเงินจริงต้องผ่านการเงินเท่านั้น สร้างเอกสารเปิดให้ staff ได้
    match /invoices/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isFinance() || isManager();
      allow delete: if isFinance() || isManager();
    }

    // ผู้แนะนำ (referral QR) — เดิมพนักงานคนไหนก็กด "จ่าย Commission" ให้ผู้แนะนำเองได้เลย ตกอยู่ใต้
    // catch-all กว้างเกินไป สร้างผู้แนะนำใหม่ยังเปิดให้ staff ได้ แต่ทำเครื่องหมายจ่ายแล้วต้องการเงิน/ผู้จัดการ
    match /referrers/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isFinance() || isManager();
      allow delete: if isFinance() || isManager();
    }

    // โปรแกรมแนะนำเพื่อน — เดิมพนักงานคนไหนก็กด "ผ่านเกณฑ์/ไม่ผ่านเกณฑ์/จ่ายรางวัล" ได้เลย ตกอยู่ใต้
    // catch-all กว้างเกินไป บันทึกการแนะนำใหม่ยังเปิดให้ staff ได้ แต่การอนุมัติ/จ่ายเงินต้องการเงิน/ผู้จัดการ
    match /referrals/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isFinance() || isManager();
      allow delete: if isFinance() || isManager();
    }

    // พบระหว่างตรวจสอบ Firestore Rules ทั้งไฟล์อย่างเป็นระบบ (v1.0.299) — เจอ collection ที่มีการอนุมัติ/
    // ปฏิเสธเงินจริงแบบเดียวกับ price_negotiations/invoices/referrals ด้านบนอีก 9 จุด ที่ยังตกอยู่ใต้
    // catch-all isStaff() กว้างเกินไป (ไม่เคยมี match block เจาะจงมาก่อนเลย) พนักงานทั่วไปกด "อนุมัติ"
    // คำขอคืนเงิน/ใบสั่งซื้อ/ข้อเสนอรับซื้อรถ/เคลมประกัน ฯลฯ ได้เองโดยไม่ต้องผ่านการเงิน/ผู้จัดการ
    match /refund_requests/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isFinance() || isManager();
      allow delete: if isFinance() || isManager();
    }

    match /purchase_orders/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isManager();
    }

    match /supplier_pos/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isManager();
    }

    // debts เป็นบัญชีติดตามหนี้แบบเดียวกับ debt_settlements (isFinance() ล้วน) ที่มีอยู่แล้วในไฟล์นี้ —
    // น่าจะตกหล่นตอนเพิ่ม debt_settlements ไปก่อนหน้านี้
    match /debts/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isFinance();
    }

    match /deposits/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isFinance() || isManager();
      allow delete: if isFinance() || isManager();
    }

    match /trade_ins/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isManager();
    }

    match /warranty_claims/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isManager();
    }

    match /warranty_service_claims/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isManager();
    }

    match /finance_rate_sheets/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isFinance() || isManager();
      allow delete: if isFinance() || isManager();
    }

    // ตรวจสอบเพิ่มเติม (v1.0.300) — finance_applications/finance_tracker เป็นเครื่องมือติดตามสถานะยื่น
    // ไฟแนนซ์ที่เซลส์เจ้าของดีลใช้ประจำ (พิมพ์บันทึก/ติ๊กเอกสารที่ลูกค้าส่งมา, เลื่อนสถานะระหว่างทางเช่น
    // "ระหว่างพิจารณา"/"อนุมัติมีเงื่อนไข") จึงไม่ล็อกทั้ง collection ให้การเงิน/ผู้จัดการเท่านั้นแบบ collection
    // อื่นๆ (จะบล็อกงานประจำวันของเซลส์โดยไม่จำเป็น) แต่ล็อกเฉพาะ "การตัดสินใจสุดท้าย" — เปลี่ยนสถานะเป็น
    // อนุมัติ/ปฏิเสธ ซึ่งเป็นผลจริงจากธนาคารและกระทบยอดสินเชื่อ/คอมมิชชั่น ต้องผ่านการเงิน/ผู้จัดการเท่านั้น
    // (v1.0.308) เอกสารราชการ (gov_docs — โอนกรรมสิทธิ์/ภาษีป้าย/ทะเบียนรถใหม่) เดิมไม่มีกฎเจาะจงเลย
    // ตกไปใช้ catch-all กว้างท้ายไฟล์ (isStaff() ธรรมดา) พนักงานคนไหนก็ทำเครื่องหมาย "เสร็จสิ้น" ปลอมได้เอง
    // ทั้งที่เป็นการรับรองว่าทำเรื่องกับราชการ (กรมขนส่ง/สรรพากร) เสร็จจริงแล้ว ถ้าปลอมได้จะปกปิดการโอน
    // กรรมสิทธิ์ที่ยังไม่เสร็จจริงได้ — งานประจำวัน (รอดำเนินการ/กำลังดำเนินการ) ยังทำได้ตามเดิม ล็อกแค่
    // จุดที่ทำเครื่องหมาย "เสร็จสิ้น" ให้ต้องผ่านผู้จัดการขึ้นไปเท่านั้น
    function govDocCompletionOk() {
      return !('status' in request.resource.data)
        || (resource != null && request.resource.data.status == resource.data.status)
        || request.resource.data.status != 'เสร็จสิ้น'
        || isManager();
    }

    function financeStatusChangeOk() {
      return !('status' in request.resource.data)
        || (resource != null && request.resource.data.status == resource.data.status)
        || !(request.resource.data.status in ['approved', 'rejected'])
        || isFinance() || isManager();
    }

    // (v1.0.307) เคลมประกัน — งานสำรวจ/แจ้งเคลม/ซ่อมเป็นงานประจำวันของช่าง/เซลส์ตามปกติ แต่ "อนุมัติ" เป็น
    // การตัดสินใจวงเงินจ่ายจริง เดิม isStaff() เขียนได้หมด (สถานะ + วงเงินอนุมัติ) ใช้ financeStatusChangeOk()
    // เดิมล็อกสถานะไม่พอ เพราะพนักงานยังแก้ field "approved" (วงเงิน) ทีหลังได้โดยไม่แตะ status เลย เพิ่ม
    // เงื่อนไข "ห้ามแก้ approved เว้นแต่การเงิน/ผู้จัดการ" แยกอีกชั้น
    function insuranceApprovalOk() {
      return financeStatusChangeOk()
        && (!('approved' in request.resource.data)
            || (resource != null && request.resource.data.approved == resource.data.get('approved', 0))
            || isFinance() || isManager());
    }

    match /finance_applications/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff() && financeStatusChangeOk();
      allow delete: if isFinance() || isManager();
    }

    match /finance_tracker/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff() && financeStatusChangeOk();
      allow delete: if isFinance() || isManager();
    }

    // จุดรับชำระเงินสด (Cashier Desk) — เดิมพนักงานคนไหนก็สร้างรายการ "รับเงินแล้ว" หรือลบบิลค้างชำระได้เอง
    // เสี่ยงปลอมบันทึกรับเงิน/ปิดบังยอดขาดหายได้ จำกัดให้ต้องเป็นการเงิน/ผู้จัดการเท่านั้นที่บันทึก/ลบได้จริง
    match /cashier_payments/{docId} {
      allow read: if isStaff();
      allow create, update, delete: if isFinance() || isManager();
    }

    match /cashier_pending_bills/{docId} {
      allow read: if isStaff();
      allow create, update, delete: if isFinance() || isManager();
    }

    // บัญชีทรัพย์สินถาวรของบริษัท (ต้นทุน/อายุการใช้งาน/มูลค่าตามบัญชีหลังหักค่าเสื่อม) — บัญชีภายใน ไม่ใช่รายการขาย
    match /assets/{docId} {
      allow read: if isStaff();
      allow write: if isFinance() || isManager();
    }

    // สินเชื่อ Floor Plan ของดีลเลอร์เอง (วงเงิน/ยอดค้างกับธนาคาร) — ไม่ใช่ข้อมูลลูกค้า เป็นภาระหนี้บริษัทจริง
    match /floor_plan/{docId} {
      allow read, write: if isFinance() || isManager();
    }

    // ปิดบัญชีสิ้นเดือน (รายรับ/ต้นทุน/กำไรขั้นต้นของทั้งบริษัท) — ไม่ใช่ข้อมูลที่พนักงานขายทั่วไปต้องเห็น
    match /monthly_close_items/{docId} {
      allow read: if isFinance() || isManager();
      allow write: if isFinance();
    }

    // ใบเสร็จเบิกค่าใช้จ่าย — เดิมปุ่ม "อนุมัติ/ปฏิเสธ" ไม่มีการเช็คสิทธิ์เลย พนักงานคนไหนก็กดอนุมัติใบเสร็จ
    // ของใครก็ได้ (รวมถึงของตัวเอง) เหมือน expense_claims ที่แก้ไปแล้ว
    match /expense_receipts/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isFinance() || isManager() || isHR();
      allow delete: if isFinance() || isManager();
    }

    match /expense_claims/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isHR() || isManager();
    }

    // เงินจริงที่จ่ายให้พาร์ทเนอร์ (referral/reseller) — การอนุมัติสั่งจ่ายจริง เหมือน tech_kpi_bonus_approvals
    match /partner_commissions/{docId} {
      allow read: if isStaff();
      allow write: if isFinance() || isManager();
    }

    // เป้าหมาย/ตัวเลขการเงินเชิงกลยุทธ์ของบริษัท ไม่ใช่ข้อมูลลูกค้า/ใบเสร็จที่พนักงานขายต้องใช้ประจำวัน
    match /financial_goals/{docId} {
      allow read, write: if isFinance() || isManager();
    }

    // สัญญาที่มีมูลค่าดีล (value) — แก้ไข/ลบต้องผู้จัดการเท่านั้น กันแก้มูลค่าสัญญาโดยไม่มีอำนาจ
    match /contracts/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isManager();
    }

    match /leasing_contracts/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isManager();
    }

    // ── HR — HR role & above ──────────────────────────────────────────────────
    match /staff/{docId} {
      allow read: if isStaff();
      // (v1.0.303) เงินเดือนย้ายไปเก็บที่ staff_salaries แยกต่างหากแล้ว (อ่านได้แค่ isHR()/isFinance()/
      // isManager()) เพราะ collection นี้ต้องเปิดให้ isStaff() อ่านได้กว้างต่อไป (หน้าอื่นอีกหลายหน้าต้องใช้
      // ชื่อ/แผนกพนักงาน) — ห้ามเขียน/แก้ salary ผ่าน doc นี้อีกต่อไป แต่ยัง "อ่าน" ได้เพื่อ backward-compat
      // กับเอกสารเก่าที่ยังไม่ได้ย้ายข้อมูลออก (ดูปุ่ม "ย้ายข้อมูลเงินเดือน" ในหน้า Staff — เจ้าของ/แอดมินเท่านั้น) เช็คเทียบกับค่าที่มีอยู่เดิม
      // (ไม่ใช่แค่ห้าม field นี้เฉยๆ) เพื่อไม่ให้บล็อกการแก้ไข field อื่นบนเอกสารเก่าที่ยังมี salary ค้างอยู่
      allow create: if isHR() && !('salary' in request.resource.data);
      allow update: if isHR() && (
        !('salary' in request.resource.data) ||
        request.resource.data.salary == resource.data.get('salary', null)
      );
      allow delete: if isHR();
    }

    // เก็บเงินเดือนแยกจาก staff doc (v1.0.303) — เดิม salary ฝังอยู่ใน staff/{docId} ที่เปิดให้ isStaff()
    // (พนักงานทุกคน) อ่านได้กว้างมาก ทำให้ใครก็ดึงเงินเดือนของเพื่อนร่วมงานทุกคนผ่าน Firestore SDK ตรงๆได้
    // แม้จะซ่อนที่ UI แล้วก็ตาม (v1.0.302) — ย้ายมาเก็บที่นี่แทน จำกัดอ่าน/เขียนเฉพาะ HR/การเงิน/ผู้จัดการ
    // เท่านั้น id ของเอกสารตรงกับ id ของ staff/{docId} ตัวเดียวกันเสมอ (ความสัมพันธ์ 1:1)
    match /staff_salaries/{docId} {
      allow read: if isHR() || isFinance() || isManager();
      allow write: if (isHR() || isFinance() || isManager()) && nonNegIfPresent('salary');
    }

    match /staff_loans/{docId} {
      allow read: if isHR() || isManager();
      // ป้องกันยื่นขอกู้ยืมยอด 0 หรือติดลบ — UI เช็คแค่ฝั่ง client เท่านั้น (StaffLoan.js) ข้ามได้ง่ายๆ
      allow create: if isStaff() && positiveIfPresent('amount');
      allow update, delete: if isHR();
    }

    // ชั่วโมง OT ใช้คำนวณค่าจ้างจริง (hourlyRate × hours) เหมือน staff_loans — พนักงานยื่นขอได้เอง
    // แต่แก้ไข/อนุมัติ/ลบต้อง HR หรือผู้จัดการเท่านั้น
    match /overtime_records/{docId} {
      allow read: if isHR() || isManager();
      allow create: if isStaff();
      allow update, delete: if isHR() || isManager();
    }

    // ไฟล์เอกสารส่วนตัวพนักงานที่อัปโหลดจริง (fileUrl) — อ่อนไหวระดับเดียวกับ staff_profiles
    match /staff_documents/{docId} {
      allow read: if isHR() || isManager();
      allow write: if isHR();
    }

    // แผนสวัสดิการ (ผู้ให้บริการ/ค่าใช้จ่าย/สิทธิ์) เป็นการตั้งค่าระดับองค์กร ไม่ใช่ของพนักงานคนเดียว
    match /welfare_items/{docId} {
      allow read: if isStaff();
      allow write: if isHR() || isManager();
    }

    match /leave_requests/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isHR() || isManager();
    }

    // หน้า Attendance เป็นแบบ kiosk — พนักงานคนไหนก็แตะเข้า/ออกงานของตัวเองได้จากอุปกรณ์ที่ตั้งไว้หน้าออฟฟิศ
    // จำกัดแค่ isHR()/isManager() จะทำให้พนักงานทั่วไปลงเวลาเข้า-ออกงานเองไม่ได้เลย (ผิดจากที่ UI ออกแบบไว้)
    match /attendance/{docId} {
      allow read, write: if isStaff();
    }

    match /performance_reviews/{docId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /team_targets/{docId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    // เป้ายอดขาย/งบ FOC รายปีของทั้งบริษัท — สิทธิ์เดียวกับ team_targets เพื่อไม่ให้พนักงานขายแก้เป้าตัวเองได้
    match /sales_budgets/{docId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    // กติกาคอมมิชชั่น — เดิมไม่มีการเขียนจริงเลย (หน้าเก็บที่ localStorage) จึงไม่เคยมีความเสี่ยง แต่ตอนนี้
    // เชื่อม Firestore จริงแล้ว ต้องกันไม่ให้พนักงานขายแก้อัตราคอมมิชชั่นของตัวเองได้ เหมือน sales_budgets
    match /commission_rules/{docId} {
      allow read: if isStaff();
      allow write: if (isFinance() || isManager()) && validCommissionValue();
    }

    // งบประมาณรายปี (รายได้/ต้นทุน/ค่าใช้จ่าย) ของทั้งบริษัท — สิทธิ์เดียวกับ sales_budgets/commission_rules
    match /budget_planning/{docId} {
      allow read: if isStaff();
      allow write: if isFinance() || isManager();
    }

    // งบการตลาดต่อช่องทาง ใช้คำนวณ ROI% ของทีมมาร์เก็ตติ้งเอง — เหตุผลเดียวกับ sales_budgets
    match /marketing_budgets/{docId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /employee_evaluations/{docId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /disciplinary_records/{docId} {
      allow read: if isHR() || isManager();
      allow write: if isHR() || isManager();
    }

    // ประกาศภายในบริษัท — พนักงานทุกคนอ่านได้ แต่สร้าง/แก้ไข/ลบเนื้อหาได้เฉพาะ "ผู้มีอำนาจ" (HR/ผู้จัดการขึ้นไป) เท่านั้น
    // เดิมตกอยู่ใต้ catch-all isStaff() กว้างเกิน ทำให้พนักงานทั่วไปสร้างประกาศทั้งองค์กรได้เอง
    // ยกเว้น pinned/readByUids ที่พนักงานทั่วไปแก้เองได้ (ปักหมุดของตัวเอง + นับอ่านจริงตอนเปิดดู)
    match /announcements_hr/{docId} {
      allow read: if isStaff();
      allow create, delete: if isHR() || isManager();
      allow update: if isHR() || isManager()
        || (isStaff() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'body', 'type', 'scope', 'targetCompanyId', 'targetDepartment', 'author', 'time']));
    }

    // เรื่องร้องเรียนภายในของพนักงาน — คนละทิศทางกับ disciplinary_records ด้านบน
    // (พนักงานร้องเรียนขึ้นไปหา HR/ผู้จัดการ ไม่ใช่ฝ่ายบริหารตักเตือนพนักงาน)
    // ผู้ยื่นเห็นแค่เรื่องของตัวเอง + HR/ผู้จัดการเห็นทั้งหมด — แก้ไข/ปิดเรื่องได้เฉพาะ HR/ผู้จัดการเท่านั้น
    match /staff_grievances/{docId} {
      allow read: if isHR() || isManager() || (isSignedIn() && resource.data.get('submittedBy', '') == uid());
      allow create: if isStaff() && request.resource.data.get('submittedBy', '') == uid();
      allow update, delete: if isHR() || isManager();
    }

    // แบบสำรวจ mood รายวันของพนักงาน (คะแนน+โน้ตส่วนตัว) — ส่งได้ทุกคนแต่อ่านของคนอื่นได้แค่ HR/ผู้จัดการ
    // เพื่อความเป็นส่วนตัว (ระหว่างตรวจพบด้วยว่าฟิลด์ staff/dept เดิม hardcode เป็นข้อความคงที่ทุกครั้ง
    // ไม่ตรงกับผู้ส่งจริงเลย — แก้ที่หน้า MoodSurvey.js ให้ใช้ชื่อผู้ใช้จริงแล้วในรอบนี้ด้วย)
    match /mood_responses/{docId} {
      // เพิ่มสิทธิ์ให้เจ้าตัวอ่านของตัวเองย้อนหลังได้ด้วย (ผูกด้วย uid) — เดิมพนักงานทั่วไปอ่านของตัวเองไม่ได้เลย
      // แม้แต่ที่ตัวเองเพิ่งส่งไป ทำให้หน้าที่เช็ค "ตอบวันนี้ไปแล้วหรือยัง" ใช้งานไม่ได้จริงสำหรับพนักงานทั่วไป
      allow read: if isHR() || isManager() || (isSignedIn() && resource.data.get('uid', '') == uid());
      allow write: if isStaff();
    }

    match /recruitment/{docId} {
      allow read, write: if isHR() || isManager();
    }

    match /onboarding_staff/{docId} {
      allow read, write: if isHR() || isManager();
    }

    match /offboarding_staff/{docId} {
      allow read, write: if isHR() || isManager();
    }

    // ── Insurance ─────────────────────────────────────────────────────────────
    match /insurance_policies/{docId} {
      allow read, write: if isStaff();
    }

    match /insurance_claims/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff() && insuranceApprovalOk();
      allow delete: if isFinance() || isManager();
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{docId} {
      allow read: if isSignedIn() &&
        (resource.data.get('userId', '') == uid() || isAdmin());
      allow create: if isStaff();
      allow update: if isSignedIn() &&
        (resource.data.get('userId', '') == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Marketing & Events ────────────────────────────────────────────────────
    match /campaigns/{docId} {
      allow read, write: if isStaff();
    }

    match /events/{docId} {
      allow read, write: if isStaff();
    }

    match /promotions/{docId} {
      allow read, write: if isStaff();
    }

    // ── Quality & Compliance ─────────────────────────────────────────────────
    match /complaints/{docId} {
      allow read, write: if isStaff();
    }

    match /inspections/{docId} {
      allow read, write: if isService() || isManager();
    }

    // บริการรับ-ส่งรถลูกค้า (v1.0.304) — เก็บที่อยู่รับ/ส่งรถของลูกค้า ไม่เคยมี match block มาก่อนเลย ตกอยู่ใต้
    // catch-all isStaff() กว้างๆ (ทุกแผนกรวม HR/การเงินที่ไม่เกี่ยวข้องเลย) เห็นที่อยู่ลูกค้าได้ทั้งหมด —
    // เป็นฟีเจอร์เฉพาะฝ่ายบริการ จำกัดสิทธิ์ให้ตรงกับแผนกที่ใช้งานจริงเหมือน inspections ด้านบน
    match /courtesy_car_jobs/{docId} {
      allow read, write: if isService() || isManager();
    }

    match /gov_docs/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff() && govDocCompletionOk();
      allow delete: if isManager();
    }

    match /sop_documents/{docId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /legal_references/{docId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    // แหล่ง RAG อีก 2 ตัวที่ตกหล่นไปตอนเพิ่มกฎ sop_documents/legal_references — เดิมพนักงานทั่วไป
    // แก้ไข/ลบ Product Knowledge หรือ KB ได้เหมือนกันหมด ทั้งที่ควรจำกัดเท่า SOP/กฎหมาย
    match /kb_articles/{docId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /product_knowledge/{docId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    // ── RAG (Phase 3) — embedding ของความรู้ภายใน (SOP/คู่มือ/Product Knowledge/กฎหมาย)
    // เขียนอัตโนมัติจาก core/db.js ทุกครั้งที่แหล่งข้อมูลต้นทางถูกสร้าง/แก้ไข — สิทธิ์เท่ากับ
    // การอ่าน/เขียนข้อมูลต้นทางเหล่านั้นเอง (ไม่มีข้อมูลลูกค้า/ธุรกิจส่วนตัวอยู่ใน Phase นี้)
    match /rag_chunks/{docId} {
      allow read, write: if isStaff();
    }

    // ── Shared reference data & org-wide settings — admin manages ────────────
    match /master_data/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /company_profile/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /whitelabel_settings/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ข้อมูลนิติบุคคล/สาขา (เลขผู้เสียภาษี/ที่อยู่/เบอร์/อีเมล) — เดิมพนักงานทั่วไปแก้ได้เหมือน company_profile
    // ไม่ทัน จำกัดไว้แค่ผู้จัดการขึ้นไปเหมือนกัน
    match /companies/{docId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    // นิติบุคคลจริงของเจ้าของระบบ (รองรับ 1 user ทำงานหลายบริษัท) — คนละแนวคิดกับ companies ด้านบน
    // (companies ด้านบน = ลูกค้าองค์กร/บริษัทคู่ค้า B2B ไม่ใช่บริษัทเจ้าของระบบเอง)
    match /org_companies/{docId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    // ฟิลด์ที่เพิ่มเองได้ (custom fields) ปรับ schema ของฟอร์มทั้งระบบ ไม่ใช่ข้อมูลรายวันของพนักงาน
    match /custom_fields/{docId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /sms_otp_settings/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ── Finance-adjacent config — finance role manages ────────────────────────
    match /bank_partner_info/{docId} {
      allow read, write: if isFinance();
    }

    match /insurance_rate_cards/{docId} {
      allow read, write: if isFinance() || isManager();
    }

    match /insurance_proposals/{docId} {
      allow read, write: if isStaff();
    }

    // (v1.0.306) เดิม isStaff() เขียนได้หมดทุก field รวม status — พนักงานคนไหนก็ยิง updateDocData
    // ตรงกด status เป็น 'success' ปลอมได้เอง ไม่ต้องรอใครยืนยัน (ปุ่ม "✅ ยืนยันการชำระ" ใน
    // PaymentGateway.js ตั้งใจให้เป็นการกดยืนยันด้วยมือว่าได้รับเงินจริง ไม่ใช่ webhook อัตโนมัติ) แก้ให้
    // สร้างรายการรอชำระได้ตามเดิม (staff ทั่วไปสร้าง QR ให้ลูกค้าที่หน้าร้านได้) แต่ยืนยัน/ทำเครื่องหมาย
    // ล้มเหลวต้องผ่านการเงิน/ผู้จัดการเท่านั้น (ตรงกับ pattern invoices/refund_requests ที่แก้ไปแล้ว)
    match /payment_transactions/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isFinance() || isManager();
    }

    // (v1.0.306) เดิม isStaff() เขียนได้หมด — พนักงานคนไหนก็กดปุ่ม "หักงวดนี้" (บันทึกว่าลูกค้าจ่ายแล้ว)
    // ปลอมได้เอง เป็นการบันทึกข้อเท็จจริงทางการเงินเหมือน cashier_payments ไม่ใช่แค่คำขอที่รออนุมัติ
    // แก้ให้ทั้งสร้างสัญญาผ่อนใหม่และบันทึกงวดที่จ่ายแล้วต้องผ่านการเงิน/ผู้จัดการเท่านั้น
    match /installment_plans/{docId} {
      allow read: if isStaff();
      allow create, update, delete: if isFinance() || isManager();
    }

    match /charging_sessions/{docId} {
      allow read, write: if isStaff();
    }

    // ── Gamification (game-integrity only, not real money — staff-writable) ──
    match /gamification_events/{docId} {
      allow read, write: if isStaff();
    }

    match /staff_points/{docId} {
      allow read, write: if isStaff();
    }

    // ── AI Officer chat history — private per user ────────────────────────────
    match /ai_officer_chats/{docId} {
      allow read, update, delete: if isSignedIn() && resource.data.get('userId', '') == uid();
      allow create: if isStaff() && request.resource.data.get('userId', '') == uid();
    }

    // แชท AI Assistant ส่วนตัว — เดิมกรองด้วย uid แค่ฝั่ง client เท่านั้น (comment ในโค้ดหน้านั้นยอมรับตรงๆว่า
    // "ข้อความเก่าก่อนแก้ที่ไม่มี uid" เคยเห็นรวมกันทุกคน) ตอนนี้บังคับที่ระดับ rules จริงเหมือน ai_officer_chats
    match /chat_ai_assistant/{docId} {
      allow read, delete: if isStaff() && resource.data.get('uid', '') == uid();
      allow create: if isStaff() && request.resource.data.get('uid', '') == uid();
    }

    // ── Client-side error monitoring — anyone signed in can report, only staff manage ──
    match /error_log/{docId} {
      allow read, update, delete: if isStaff();
      allow create: if isSignedIn();
    }

    // ── System security — admin only (ค่า secret จริง/ปิด-เปิดนโยบายทั้งองค์กร/ยกเลิก session คนอื่น) ──
    match /api_keys/{docId} {
      allow read, write: if isAdmin();
    }

    match /security_policies/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /security_sessions/{docId} {
      allow read, write: if isAdmin();
    }

    // ── PDPA — พนักงานบันทึกความยินยอมได้ตามงานปกติ แต่คำขอสิทธิ์ตามกฎหมาย (DSR) ต้องผู้จัดการปิดงาน ──
    match /pdpa_consents/{docId} {
      allow read, write: if isStaff();
    }

    match /pdpa_dsr_requests/{docId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    // ── Quality/Compliance audits — findings อาจครอบคลุมเรื่อง PDPA ด้วย จึงเข้มเท่า legal_references ──
    match /compliance_audits/{docId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    // ── System integrations/backups/webhooks — admin เท่านั้น ──────────────────
    // webhooks เก็บ field "secret" เป็นข้อความจริงตามที่กรอกในฟอร์ม (ไม่ได้เข้ารหัส/ปกปิด) และ
    // system_integrations เก็บ config การเชื่อมต่อ third-party — ทั้งสองไม่ควรให้ staff ทั่วไปอ่าน/แก้
    // system_backups: การ "กู้คืน" (restore) เขียนทับข้อมูลจริงทั้งระบบได้ ต้องเป็นแอดมินสั่งเท่านั้น
    match /webhooks/{docId} {
      allow read, write: if isAdmin();
    }

    match /system_integrations/{docId} {
      allow read, write: if isAdmin();
    }

    match /system_backups/{docId} {
      allow read, write: if isAdmin();
    }

    // ── HR ที่อ่อนไหวสูง — ข้อมูลผู้สมัครงาน/แผนสืบทอดตำแหน่ง/ผลประเมิน ไม่ใช่ staff ทั่วไปควรเห็น ──
    match /recruitment_applicants/{docId} {
      allow read, write: if isHR() || isManager();
    }

    match /staff_profiles/{docId} {
      allow read: if isStaff();
      // (v1.0.304) เงินเดือนย้ายไปเก็บที่ staff_profile_salaries แยกต่างหากแล้ว (collection นี้เป็นทำเนียบ
      // พนักงานคู่ขนานแยกจาก staff/{docId} — id ไม่ตรงกัน จึงแยก collection เก็บเงินเดือนต่างหากด้วย ไม่ใช้
      // staff_salaries ร่วมกัน) ห้ามเขียน/แก้ salary ผ่าน doc นี้อีกต่อไป เอกสารเก่าที่ยังฝัง salary อยู่ยังแก้
      // field อื่นได้ปกติ (เช็คเทียบค่าเดิมเหมือน staff.salary)
      allow create: if (isHR() || isManager()) && !('salary' in request.resource.data);
      allow update: if (isHR() || isManager()) && (
        !('salary' in request.resource.data) ||
        request.resource.data.salary == resource.data.get('salary', null)
      );
      allow delete: if isHR() || isManager();
    }

    // เก็บเงินเดือนแยกจาก staff_profiles doc (v1.0.304) — เดิม salary ฝังอยู่ใน staff_profiles/{docId} ที่
    // เปิดให้ isStaff() (พนักงานทุกคน) อ่านได้กว้าง เหมือนบั๊กเดียวกับที่เคยพบและแก้ใน staff/{docId} ไปแล้ว
    // (v1.0.303) แต่หลุดรอดมาเพราะเป็น collection คู่ขนานแยกต่างหาก id ของเอกสารตรงกับ staff_profiles/{docId}
    // ตัวเดียวกันเสมอ (ความสัมพันธ์ 1:1)
    match /staff_profile_salaries/{docId} {
      allow read: if isHR() || isFinance() || isManager();
      allow write: if (isHR() || isFinance() || isManager()) && nonNegIfPresent('salary');
    }

    match /succession_plans/{docId} {
      allow read, write: if isHR() || isManager();
    }

    match /performance_scorecards/{docId} {
      allow read, write: if isManager();
    }

    // ── Default: any other collection requires staff auth ────────────────────
    // สำคัญมาก (พบ 2026-07-23 ระหว่างเขียนเทส rules ครั้งแรกของโปรเจกต์): Firestore ประเมิน
    // "ทุก" match block ที่ path ตรงกัน แล้วรวมผลแบบ OR — ไม่ใช่ "block เจาะจงกว่าชนะ" อย่างที่คนมัก
    // เข้าใจผิด แปลว่า catch-all นี้ (isStaff() แบบกว้างๆ) จะ "แข่ง" กับทุก match block ด้านบนที่จำกัด
    // สิทธิ์แคบกว่า isStaff() เสมอ (เช่น payroll ที่ควรเป็น isFinance() เท่านั้น, audit_log ที่ห้ามแก้ไข/
    // ลบเด็ดขาด, users ที่ควรจำกัดที่ isManager()) — ถ้าไม่กันไว้ตรงนี้ staff ธรรมดาทุกคนจะยังอ่าน/เขียน
    // collection เหล่านั้นได้อยู่ดีผ่าน catch-all นี้ โดยไม่ต้องผ่านเงื่อนไขที่เข้มกว่าเลย (ยืนยันด้วยเทสจริง
    // ผ่าน emulator แล้ว — sales role อ่าน/เขียน users collection ได้ทั้งที่ควรจะถูกบล็อก จนกว่าจะกันตรงนี้)
    // ต้องเพิ่มชื่อ collection ใหม่ในลิสต์นี้ทุกครั้งที่เขียน match block ที่จำกัดสิทธิ์แคบกว่า isStaff()
    function hasNarrowerRuleThanStaff(collection) {
      return collection in [
        'meta', 'users', 'roles', 'audit_log', 'settings', 'branches',
        'commissions', 'payroll', 'petty_cash', 'withholding_tax_certs', 'billing_runs', 'custom_order_docs',
        'expenses', 'expense_approvals', 'cash_flow', 'bank_reconciliation', 'bank_transactions',
        'payroll_records', 'salary_scale_staff', 'bonus_pool_staff', 'tech_kpi_bonus_approvals',
        'financial_closings', 'debt_settlements', 'expense_claims',
        'staff', 'staff_salaries', 'staff_loans', 'leave_requests', 'attendance', 'performance_reviews', 'team_targets',
        'employee_evaluations', 'disciplinary_records', 'staff_grievances', 'recruitment', 'onboarding_staff', 'offboarding_staff',
        'notifications', 'inspections', 'courtesy_car_jobs', 'sop_documents', 'legal_references', 'kb_articles', 'product_knowledge',
        'master_data', 'company_profile', 'whitelabel_settings', 'sms_otp_settings',
        'bank_partner_info', 'insurance_rate_cards', 'ai_officer_chats',
        'api_keys', 'security_policies', 'security_sessions',
        'pdpa_consents', 'pdpa_dsr_requests', 'compliance_audits',
        'webhooks', 'system_integrations', 'system_backups',
        'recruitment_applicants', 'staff_profiles', 'staff_profile_salaries', 'succession_plans', 'performance_scorecards',
        'partner_commissions', 'financial_goals', 'contracts', 'leasing_contracts',
        'overtime_records', 'staff_documents', 'welfare_items',
        'assets', 'floor_plan', 'monthly_close_items', 'expense_receipts',
        'companies', 'org_companies', 'custom_fields', 'documents', 'mood_responses', 'chat_ai_assistant',
        'announcements_hr', 'comm_messages',
        'sales_budgets', 'marketing_budgets', 'commission_rules', 'budget_planning',
        'price_negotiations', 'invoices', 'referrers', 'referrals',
        'vehicles', 'bookings', 'booking_national_ids',
        'refund_requests', 'purchase_orders', 'supplier_pos', 'debts', 'deposits',
        'trade_ins', 'warranty_claims', 'warranty_service_claims', 'finance_rate_sheets',
        'finance_applications', 'finance_tracker', 'cashier_payments', 'cashier_pending_bills',
        'vehicle_catalog_overrides', 'vehicle_catalog_additions', 'payment_transactions', 'installment_plans',
        'insurance_claims', 'tax_filings', 'gov_docs'
      ];
    }

    match /{collection}/{docId} {
      allow read, write: if isStaff() && !hasNarrowerRuleThanStaff(collection);
    }
  }
}
