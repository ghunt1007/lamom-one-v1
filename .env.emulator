# ใช้กับ `npm run dev:emulator` เท่านั้น — ต่อกับ Firebase Emulator บนเครื่อง (ข้อมูลสมมติ) ไม่ใช่ฐานข้อมูลจริง
VITE_USE_EMULATOR=1
