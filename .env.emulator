VITE_FIREBASE_STORAGE_BUCKET=demo-lamom.appspot.com
VITE_FIREBASE_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000000000000000
VITE_FIREBASE_APP_CHECK_KEY=
VITE_R2_WORKER_URL=
VITE_AI_PROXY_URL=
